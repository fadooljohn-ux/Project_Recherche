#!/bin/sh
# Supported local entry point: pinned Intel/Pixi precision and offline execution.
set -eu
recherche_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$recherche_repo"
export PYTHONPATH="$recherche_repo/src"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
# One setting locates external data; tools/recherche_common.py reads the same variable.
recherche_data_root=${RECHERCHE_DATA_ROOT:-"$recherche_repo/../Project Recherche Data"}
if [ -n "${RECHERCHE_DATA_ROOT:-}" ] && [ ! -d "$RECHERCHE_DATA_ROOT" ]; then
  echo "RECHERCHE_DATA_ROOT is not a directory: $RECHERCHE_DATA_ROOT" >&2
  exit 2
fi
# On hosts whose Command Line Tools libxcrun has no x86_64 slice, the /usr/bin/git
# shim cannot start from the Intel runtime. Only then, put the native Git first.
recherche_native_tools=/Library/Developer/CommandLineTools/usr/bin
if [ -x "$recherche_native_tools/git" ] && \
   ! /usr/bin/arch -x86_64 /usr/bin/git --version >/dev/null 2>&1; then
  PATH="$recherche_native_tools:$PATH"
  export PATH
fi
update_master_workbook() {
  if [ -n "${RECHERCHE_WORKBOOK_HOOK:-}" ]; then
    "$RECHERCHE_WORKBOOK_HOOK" "$@"
    return $?
  fi
  # The hash-pinned openpyxl backend is the single supported path. The original
  # updater, which borrows the Codex app's private Node runtime, runs only on
  # explicit request for its legacy preparation and candidate modes.
  if [ "${RECHERCHE_WORKBOOK_BACKEND:-portable}" != codex-node ]; then
    if [ ! -x "$recherche_repo/.agent-venv/bin/python" ]; then
      echo 'Workbook runtime missing. Run python3 tools/agent_setup.py --install, then retry master-workbook only.' >&2
      return 1
    fi
    "$recherche_repo/.agent-venv/bin/python" "$recherche_repo/tools/agent_workbook.py" "$@"
    return $?
  fi
  recherche_artifact_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node"
  recherche_master_dir="$recherche_repo/outputs/recherche-master-20260908"
  if [ ! -x "$recherche_artifact_node/bin/node" ]; then
    echo 'RECHERCHE_WORKBOOK_BACKEND=codex-node needs the Codex app Node runtime, which is absent.' >&2
    return 1
  fi
  if [ ! -e "$recherche_master_dir/node_modules" ]; then
    ln -s "$recherche_artifact_node/node_modules" "$recherche_master_dir/node_modules"
  fi
  "$recherche_artifact_node/bin/node" "$recherche_master_dir/update.mjs" "$@"
}
if [ "${1:-}" = master-workbook ]; then
  shift
  update_master_workbook "$@"
  exit $?
fi
if [ ! -x "$recherche_repo/.pixi/envs/default/bin/python" ]; then
  echo 'Pinned environment missing. Run tools/install, then retry.' >&2
  exit 2
fi
case "${1:-}" in
  j1857-nonlinear)
